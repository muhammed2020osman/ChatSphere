\u062a\u0631\u0645\/\u0629\u060c\n            <\/p>\n\n            <p style=\"font-size: 16px; line-height: 1.8; margin-bottom: 20px;\">\n                \u0646\u062d\u064a\u0637 \u0639\u0644\u0645\u0643\u0645 \u0628\u0623\u0646\u0647 \u062a\u0645 \u062a\u0633\u062c\u064a\u0644 \u0645\u062e\u0627\u0644\u0641\u0629 \u0645\u0646 \u0646\u0648\u0639 <strong>{hfhf}<\/strong>\n                \u0628\u062a\u0627\u0631\u064a\u062e <strong>{2025-10-29}<\/strong>.\n            <\/p>\n\n            <p style=\"font-size: 16px; line-height: 1.8; margin-bottom: 20px;\">\n                <strong>\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0629:<\/strong><br>\n                {fggfh}\n            <\/p>\n\n            <p style=\"font-size: 16px; line-height: 1.8; margin-bottom: 20px;\">\n                \u0646\u0637\u0644\u0628 \u0645\u0646\u0643\u0645 \u0627\u0644\u0627\u0644\u062a\u0632\u0627\u0645 \u0628\u0627\u0644\u0642\u0648\u0627\u0646\u064a\u0646 \u0648\u0627\u0644\u0644\u0648\u0627\u0626\u062d \u0627\u0644\u0645\u0639\u0645\u0648\u0644 \u0628\u0647\u0627 \u0641\u064a \u0627\u0644\u0634\u0631\u0643\u0629\u060c\n                \u0648\u062a\u062c\u0646\u0628 \u062a\u0643\u0631\u0627\u0631 \u0645\u062b\u0644 \u0647\u0630\u0647 \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0627\u062a \u0645\u0633\u062a\u0642\u0628\u0644\u0627\u064b.\n            <\/p>\n\n            <p style=\"font-size: 16px; line-height: 1.8; margin-bottom: 20px;\">\n                \u0646\u062a\u0645\u0646\u0649 \u0644\u0643\u0645 \u062f\u0648\u0627\u0645 \u0627\u0644\u0627\u0644\u062a\u0632\u0627\u0645 \u0648\u0627\u0644\u0627\u0646\u0636\u0628\u0627\u0637.\n            <\/p>\n\n            <div style=\"margin-top: 50px;\">\n                <p style=\"font-size: 16px; line-height: 1.8;\">\n                    \u0645\u0639 \u062e\u0627\u0644\u0635 \u0627\u0644\u0634\u0643\u0631 \u0648\u0627\u0644\u062a\u0642\u062f\u064a\u0631\u060c\n                <\/p>\n                <p style=\"font-size: 16px; line-height: 1.8; margin-top: 20px;\">\n                    <strong>{gdg}<\/strong><br>\n                    {gdfg}\n                <\/p>\n            <\/div>","status":"final","company_id":1,"created_by":2,"created_at":"2025-10-20T08:36:28.000000Z","updated_at":"2025-10-20T08:36:28.000000Z","template":{"id":2,"name":"\u062e\u0637\u0627\u0628 \u0625\u0646\u0630\u0627\u0631","locale":"ar-SA","category":"\u0625\u0646\u0630\u0627\u0631","tags":["\u0645\u0648\u0627\u0631\u062f \u0628\u0634\u0631\u064a\u0629","\u0625\u0646\u0630\u0627\u0631\u0627\u062a"],"content":"<div style=\"display: flex; align-items: center; justify-content: space-between; margin-bottom: 40px; padding-bottom: 20px; border-bottom: 2px solid #e0e0e0;\">\n                <div style=\"flex: 0 0 auto;\">\n                    <img src=\"{{company.logo_img}}\" alt=\"\u0634\u0639\u0627\u0631 \u0627\u0644\u0634\u0631\u0643\u0629\" style=\"max-height: 80px; width: auto;\">\n                <\/div>\n                <div style=\"flex: 1; text-align: center; padding: 0 20px;\">\n                    <h1 style=\"margin: 0; font-size: 28px; font-weight: bold; color: #2c3e50;\">{{company.name}}<\/h1>\n                <\/div>\n            <\/div>\n            <h1 style=\"text-align:center; color: #e74c3c; margin-bottom: 20px;\">{{letter.title}}<\/h1>\n            <p style=\"text-align:center; color: #7f8c8d; margin-bottom: 30px;\">{{letter.date}}<\/p>\n\n            <p style=\"font-size: 16px; line-height: 1.8; margin-bottom: 20px;\">\n                \u0627\u0644\u0633\u064a\u062f\/\u0629 <strong>{{driver.name}}<\/strong> \u0627\u0644\u0645\u062d\u062a\u0631\u0645\/\u0629\u060c\n            <\/p>\n\n            <p style=\"font-size: 16px; line-height: 1.8; margin-bottom: 20px;\">\n                \u0646\u062d\u064a\u0637 \u0639\u0644\u0645\u0643\u0645 \u0628\u0623\u0646\u0647 \u062a\u0645 \u062a\u0633\u062c\u064a\u0644 \u0645\u062e\u0627\u0644\u0641\u0629 \u0645\u0646 \u0646\u0648\u0639 <s