# ChatSphere Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
# MySQL connection string format: mysql://username:password@host:port/database_name
# Example: mysql://root:password@localhost:3306/chatsphere
DATABASE_URL=mysql://username:password@host:3306/database_name

# Access Control
# Code required to access the application
ACCESS_CODE=your_access_code_here

# AI Services
# Google Gemini API key for drawing analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Application Environment
# Set to 'production' for production deployment
NODE_ENV=development

# Optional: Skip AI analysis in development
# Set to 'true' to skip AI analysis for faster development
SKIP_AI_ANALYSIS=false

# Optional: Server Configuration
# Port for the server to run on (default: 3000)
PORT=3000

# Optional: Session Configuration
# Secret for session management (generate a random string)
SESSION_SECRET=your_session_secret_here
